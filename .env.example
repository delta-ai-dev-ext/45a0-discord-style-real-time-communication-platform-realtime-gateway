# Local development only. Never used in production and never committed with secrets.
PORT=3000
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=realtime_gateway
COMMUNITY_SERVICE_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=replace-with-cluster-secret
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://example.clerk.accounts.dev
# CLERK_AUDIENCE=realtime_gateway
POD_NAME=local-dev-1
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_CONNECTIONS_PER_POD=5000
ACCESS_TIMEOUT_MS=300
SHUTDOWN_TIMEOUT_MS=20000
LOG_LEVEL=info
